{
  "name": "Munger AI - Chat Handler",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [160, 400],
      "webhookId": "munger-bot-webhook-001",
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram - Munger Bot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Extract key fields from incoming Telegram message\nconst update = $input.first().json;\n\n// Handle both regular messages and edited messages\nconst msg = update.message || update.edited_message;\n\nif (!msg) {\n  throw new Error('No message found in Telegram update');\n}\n\nconst chatId = msg.chat.id;\nconst text = msg.text || msg.caption || '';\nconst username = msg.from.username || msg.from.first_name || 'friend';\nconst firstName = msg.from.first_name || 'there';\nconst messageId = msg.message_id;\n\n// Create a stable session ID per chat (persists conversation history)\nconst sessionId = `munger_chat_${chatId}`;\n\nreturn [{\n  json: {\n    chatId: chatId.toString(),\n    userMessage: text,\n    username: username,\n    firstName: firstName,\n    messageId: messageId,\n    sessionId: sessionId,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
      "name": "Format Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [380, 400]
    },
    {
      "parameters": {
        "chatId": "={{ $('Format Input').item.json.chatId }}",
        "text": "_Charlie is thinking..._",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "c3d4e5f6-a7b8-9012-cdef-123456789012",
      "name": "Send Typing Indicator",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [600, 280],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram - Munger Bot"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Format Input').item.json.userMessage }}",
        "options": {
          "systemMessage": "={{ $('Format Input').item.json.systemPrompt || 'You are Charlie Munger. See the full system prompt in config/system_prompt.txt - paste its contents here.' }}"
        }
      },
      "id": "d4e5f6a7-b8c9-0123-defa-234567890123",
      "name": "Munger AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
